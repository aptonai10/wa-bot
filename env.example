# ── n8n ───────────────────────────────────────────────────────────────────────
# Production URL from your n8n Webhook node (NOT the test URL)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/wa-bot

# ── Bot behaviour ──────────────────────────────────────────────────────────────
# Prefix required before commands/questions.
# "!"  → users must type  !ask  or  !music  etc.
# ""   → bot replies to every message (noisy — not recommended for groups)
BOT_PREFIX=!
